NEBIUS_API_KEY=
TAVILY_API_KEY=
NEBIUS_MAX_OUTPUT_TOKENS=800
STUDYLENS_DAILY_NEBIUS_CALL_LIMIT=30
STUDYLENS_TOTAL_NEBIUS_CALL_LIMIT=60
STUDYLENS_DAILY_TAVILY_CALL_LIMIT=20
STUDYLENS_TOTAL_TAVILY_CALL_LIMIT=40
STUDYLENS_LIVE_ENABLED=true
STUDYLENS_REQUESTS_PER_MINUTE=6
STUDYLENS_REQUESTS_PER_HOUR=20
# Set a private random value shared by backend workers before hosting.
STUDYLENS_RATE_LIMIT_SECRET=
STUDYLENS_DB_PATH=studylens.db
# Leave DATABASE_URL empty for local SQLite. Store hosted credentials only in .env or Render secrets.
DATABASE_URL=
STUDYLENS_ENV=development
# Optional locally; Docker sets the built website path automatically.
STUDYLENS_WEB_DIST=
CORS_ORIGINS=http://localhost:5173
